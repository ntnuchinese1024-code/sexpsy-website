---
import RoomDisclaimer from './RoomDisclaimer.astro';
import type { StudyRoom } from '../lib/self-study-rooms';

interface RelatedArticle {
  slug: string;
  title: string;
}

interface Props {
  title: string;
  summary: string;
  room: StudyRoom;
  downloadPdf?: string;
  downloadWord?: string;
  aiPrompt?: string;
  tags: string[];
  estimatedMinutes?: number;
  difficulty?: string;
  relatedArticles: RelatedArticle[];
}

const {
  title,
  summary,
  room,
  downloadPdf,
  downloadWord,
  aiPrompt,
  tags,
  estimatedMinutes,
  difficulty,
  relatedArticles,
} = Astro.props;
---

<article class="space-y-10">
  <header>
    <h1 class="font-serif text-2xl font-semibold text-chestnut sm:text-3xl">{title}</h1>

    <div class="mt-3 flex flex-wrap items-center gap-2 text-xs text-chestnut/60">
      {estimatedMinutes && <span>⏱️ 約 {estimatedMinutes} 分鐘</span>}
      {difficulty && (
        <span class="rounded-full bg-chestnut/10 px-2.5 py-0.5 font-medium text-chestnut/70">{difficulty}</span>
      )}
    </div>

    {
      tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="rounded-full bg-terracotta/10 px-3 py-1 text-xs text-terracotta">#{tag}</span>
          ))}
        </div>
      )
    }
  </header>

  <section>
    <h2 class="section-heading">① 知識微導讀</h2>
    <p class="mt-3 text-base leading-relaxed text-chestnut/80">{summary}</p>
    <div
      class="prose prose-lg article-body mt-6 max-w-none font-serif leading-loose text-chestnut
             prose-headings:font-serif prose-headings:font-semibold prose-headings:text-chestnut
             prose-p:leading-loose prose-a:text-terracotta prose-a:underline prose-a:underline-offset-2
             prose-strong:text-chestnut prose-img:rounded-2xl prose-img:shadow-md"
    >
      <slot />
    </div>
  </section>

  {
    relatedArticles.length > 0 && (
      <section>
        <h2 class="section-heading">延伸閱讀</h2>
        <div class="mt-3 flex flex-wrap gap-3">
          {relatedArticles.map((article) => (
            <a
              href={`/articles/${article.slug}`}
              class="rounded-full border border-chestnut/15 bg-white/50 px-4 py-2 text-sm text-chestnut/80 transition-colors hover:border-terracotta/50 hover:text-terracotta"
            >
              📖 {article.title}
            </a>
          ))}
        </div>
      </section>
    )
  }

  {
    (downloadPdf || downloadWord) && (
      <section>
        <h2 class="section-heading">② 實用工具包下載</h2>
        <div class="mt-3 flex flex-wrap gap-3">
          {downloadPdf && (
            <a href={downloadPdf} download class="download-btn">
              📄 下載 PDF 學習單
            </a>
          )}
          {downloadWord && (
            <a href={downloadWord} download class="download-btn">
              📝 下載 Word 學習單
            </a>
          )}
        </div>
      </section>
    )
  }

  {
    aiPrompt && (
      <section>
        <h2 class="section-heading">③ AI 探索陪伴 Prompt</h2>
        <p class="mt-2 text-sm text-chestnut/60">
          複製這段文字，並附上文件，貼給你常用的 AI 聊天工具，開始一段不批判、有陪伴感的自我探索對話。
        </p>
        <div class="relative mt-3 rounded-2xl border border-chestnut/10 bg-white/60 p-5">
          <pre id="ai-prompt-text" class="whitespace-pre-wrap font-sans text-sm leading-relaxed text-chestnut/80">
{aiPrompt}
          </pre>
          <button
            type="button"
            id="copy-prompt-btn"
            class="mt-4 rounded-full bg-terracotta px-5 py-2 text-xs font-medium text-cream transition-opacity hover:opacity-90"
          >
            複製這段 Prompt
          </button>
          <p id="copy-prompt-status" class="mt-2 hidden text-xs text-chestnut/50" role="status" aria-live="polite">
            已複製到剪貼簿 🛋️
          </p>
        </div>
      </section>
    )
  }

  <section>
    <h2 class="section-heading text-chestnut/70">④ 專業陪伴與免責提醒</h2>
    <div class="mt-3">
      <RoomDisclaimer room={room} />
    </div>
  </section>
</article>

<style>
  .section-heading {
    @apply font-serif text-sm font-semibold uppercase tracking-[0.15em] text-chestnut/60;
  }
  .download-btn {
    @apply inline-flex items-center gap-2 rounded-full border border-terracotta/40 bg-terracotta/10 px-5 py-2.5 text-sm font-medium text-terracotta transition-colors hover:bg-terracotta hover:text-cream;
  }
</style>

<script>
  const copyBtn = document.getElementById('copy-prompt-btn');
  const promptText = document.getElementById('ai-prompt-text');
  const statusEl = document.getElementById('copy-prompt-status');

  copyBtn?.addEventListener('click', async () => {
    if (!promptText) return;
    try {
      await navigator.clipboard.writeText((promptText.textContent ?? '').trim());
      statusEl?.classList.remove('hidden');
      setTimeout(() => statusEl?.classList.add('hidden'), 2500);
    } catch {
      // clipboard API 在非 HTTPS 環境會被封鎖，靜默失敗即可，使用者仍可手動選取複製
    }
  });
</script>
