---
// 全站／單篇文章瀏覽數計數器。純前端 client-side fetch，不需要後端。
//
// API 供應商說明：規格原本指定 CountAPI（api.countapi.xyz），但該服務網域已經
// 完全無法解析（DNS 查詢失敗，非暫時性問題），確認已經停止服務。這裡改用行為
// 幾乎一致的替代服務 Abacus（abacus.jasoncameron.dev）：同樣是免費、免註冊、
// 單一 GET 請求打 /hit/{namespace}/{key} 就會遞增並回傳目前數值，且已驗證有
// 正確回傳 Access-Control-Allow-Origin 標頭可供瀏覽器端 fetch 使用。
// 若之後 Abacus 也停止服務，只需要改下面 API_BASE 這一個常數即可換供應商。
//
// 計數語意：算的是「造訪／閱讀次數」，不是「頁面渲染次數」——同一個瀏覽分頁
// 的同一次 session 裡，同一個 key 只會遞增一次，重複進到同一頁不會重複累加
// （細節見下方 client script 的 sessionStorage 判斷）。
//
// namespace 安全性：一開始用網站真實網域 sexpsy.tw 當 namespace，結果驗證時
// 發現數字在完全沒有真實流量的情況下持續自己往上跳——因為 Abacus 跟原本的
// CountAPI 一樣完全公開、不需要驗證，repo 又是公開的，namespace 字面字串
// 直接明文寫在原始碼裡，等於是公開邀請任何掃描公開 repo 的 bot 來打 /hit 灌水。
// 現在改成從環境變數讀取一組不可猜測的隨機字串（見 .env.example），不再把
// 真正使用中的 namespace 明文 commit 進公開原始碼。
const API_BASE = 'https://abacus.jasoncameron.dev';
const NAMESPACE = import.meta.env.PUBLIC_SOFA_NAMESPACE;

if (!NAMESPACE) {
  throw new Error(
    '<SofaCounter /> 缺少 PUBLIC_SOFA_NAMESPACE 環境變數。' +
      '本機開發請複製 .env.example 為 .env 並填入實際值；' +
      'CI／部署請在 GitHub Actions 設定對應的 secret（詳見 .env.example 說明）。'
  );
}

type Props =
  | { type: 'global'; slug?: never; class?: string; readOnly?: boolean }
  | { type: 'post'; slug: string; class?: string; readOnly?: boolean };

const props = Astro.props as Props;
const { type, class: className = '', readOnly = false } = props;

if (type === 'post' && !props.slug) {
  throw new Error('<SofaCounter type="post" /> 需要提供 slug prop');
}

const key = type === 'global' ? 'total_visits' : `post_${props.slug}`;

const label =
  type === 'global'
    ? '已有 {count} 位朋友曾在這張沙發上停下腳步'
    : '已有 {count} 位朋友曾坐在這裡讀這段故事';

// readOnly：用在文章「卡片」上顯示已知的閱讀數時要打開。卡片只是預覽縮圖，
// 訪客根本還沒點進文章，不該把「卡片有被渲染到」算成一次閱讀——所以這裡
// 一律只讀 /get、絕對不會呼叫會遞增的 /hit。真正的「+1」只發生在文章
// 內頁本身（ArticleLayout 用預設的非 readOnly 模式）。

// define:vars 會把 <script> 當成 is:inline 處理（不經過 Vite 打包），
// 所以這裡先在 frontmatter（有 import.meta.env 可用）算好 isDev，
// 再連同 API_BASE 一起傳進去，腳本本體維持純 JS、不依賴建置期替換。
const isDev = import.meta.env.DEV;
---

<span
  class:list={['sofa-counter', className]}
  data-namespace={NAMESPACE}
  data-key={key}
  data-label={label}
  data-readonly={readOnly ? 'true' : undefined}
  aria-live="polite"
>
  <span class="sofa-counter__icon" aria-hidden="true">🛋️</span>
  <span class="sofa-counter__text">
    <span class="sofa-counter__skeleton">...</span>
  </span>
</span>

<style>
  .sofa-counter {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.35em 0.9em;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-accent) 14%, transparent);
    font-size: 0.8125rem;
    line-height: 1.4;
    white-space: nowrap;
  }

  .sofa-counter__icon {
    font-size: 1em;
    transform: translateY(-0.05em);
  }

  .sofa-counter__text {
    color: var(--color-text-muted);
  }

  .sofa-counter__skeleton {
    display: inline-block;
    opacity: 0.6;
    letter-spacing: 0.05em;
  }

  .sofa-counter :global(.sofa-counter__count) {
    font-weight: 600;
    color: var(--color-accent);
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .sofa-counter :global(.sofa-counter__count.is-visible) {
    opacity: 1;
  }

  .sofa-counter :global(.sofa-counter__text-primary) {
    color: var(--color-text-primary);
  }
</style>

<script define:vars={{ apiBase: API_BASE, isDev }} is:inline>
  // 注意：define:vars 會讓這個 script 以 is:inline 方式輸出（不經過 Vite/esbuild），
  // 所以這裡刻意寫成純 JavaScript，不能用 TypeScript 型別標註語法。

  // /hit 會遞增，/get 只讀不遞增。
  // /get 打一個從來沒被 /hit 過的 key，Abacus 會回 HTTP 404（不是 200！）、
  // body 是 { error: 'Key not found' }。一定要先讀 body 判斷是不是這種
  // 「還沒有人讀過」的狀況，再看 res.ok 決定要不要丟錯——順序反過來的話，
  // 404 會在讀到 body 之前就被當成一般錯誤丟出去，永遠走不到下面的判斷。
  async function apiRequest(action, namespace, key) {
    const res = await fetch(apiBase + '/' + action + '/' + encodeURIComponent(namespace) + '/' + encodeURIComponent(key));

    let data = null;
    try {
      data = await res.json();
    } catch (error) {
      // 回應不是合法 JSON，data 維持 null，交給下面 res.ok 判斷丟錯
    }

    if (action === 'get' && data && data.error) {
      return null;
    }

    if (!res.ok) {
      throw new Error('SofaCounter: API 回應 ' + res.status);
    }

    const value = Number(data && data.value);
    if (!Number.isFinite(value)) throw new Error('SofaCounter: API 回傳格式異常');
    return value;
  }

  // 「已有 X 位朋友」算的是造訪／閱讀次數，不是每次頁面渲染都要 +1：
  // 同一個瀏覽分頁（sessionStorage 存活期間）內，同一個 key 只在第一次
  // 呼叫 /hit 遞增，之後同一 session 內再遇到同一個計數器（例如全站計數器
  // 在每一頁的 Footer 都會出現，或同一篇文章被重新整理）一律改打唯讀的
  // /get，畫面數字仍會即時更新，但不會重複計入這次造訪。
  async function fetchCount(namespace, key, readOnly) {
    if (readOnly) {
      const value = await apiRequest('get', namespace, key);
      return value === null ? 0 : value;
    }

    const storageKey = 'sofa-counter-hit:' + namespace + ':' + key;
    let alreadyHitThisSession = false;
    try {
      alreadyHitThisSession = sessionStorage.getItem(storageKey) === '1';
    } catch (error) {
      // sessionStorage 可能被瀏覽器隱私設定封鎖，視同尚未計過即可，不影響核心功能
    }

    if (alreadyHitThisSession) {
      try {
        const value = await apiRequest('get', namespace, key);
        if (value === null) throw new Error('SofaCounter: 這個 session 已標記為 hit 過，但 /get 卻找不到 key');
        return value;
      } catch (error) {
        // 讀取失敗（例如從未真的 hit 成功過）就退回 hit，至少數字還能動
        return await apiRequest('hit', namespace, key);
      }
    }

    const value = await apiRequest('hit', namespace, key);
    try {
      sessionStorage.setItem(storageKey, '1');
    } catch (error) {
      // 存不進去頂多這次 session 多算一次，不影響核心功能
    }
    return value;
  }

  async function hydrateSofaCounter(node) {
    const namespace = node.dataset.namespace;
    const key = node.dataset.key;
    const labelTemplate = node.dataset.label || '已有 {count} 位朋友曾停下腳步';
    const readOnly = node.dataset.readonly === 'true';
    const textEl = node.querySelector('.sofa-counter__text');
    if (!namespace || !key || !textEl) return;

    let displayValue;
    try {
      // 開發模式（astro dev）不打正式站的計數 API，避免本機測試灌水真實數字
      if (isDev) {
        displayValue = '（開發模式預覽）';
      } else {
        const value = await fetchCount(namespace, key, readOnly);
        displayValue = value.toLocaleString('zh-TW');
      }
    } catch (error) {
      console.warn('SofaCounter 讀取失敗，優雅降級為「許多」', error);
      displayValue = '許多';
    }

    const countHtml = '<span class="sofa-counter__count">' + displayValue + '</span>';
    textEl.innerHTML = labelTemplate.replace('{count}', countHtml);

    requestAnimationFrame(() => {
      const countEl = textEl.querySelector('.sofa-counter__count');
      if (countEl) countEl.classList.add('is-visible');
    });
  }

  // 用 currentScript 只處理「自己前面那一個」.sofa-counter 節點。
  // 每個 SofaCounter 實例都會各自輸出一段 define:vars script，
  // 如果改用 querySelectorAll 抓全頁面的 .sofa-counter，
  // 頁面上有兩個以上實例時（例如文章頁同時有 post + global 計數器）
  // 每個節點就會被重複 hydrate、重複打 API，導致灌水計數。
  const currentNode = document.currentScript && document.currentScript.previousElementSibling;
  if (currentNode && currentNode.classList.contains('sofa-counter')) {
    hydrateSofaCounter(currentNode);
  }
</script>
