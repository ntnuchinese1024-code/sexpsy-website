---
import { SERIES } from '../lib/series';
---

<div class="mb-10 space-y-4">
  <div class="relative">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-chestnut/40"
    >
      <circle cx="11" cy="11" r="7"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
    <input
      type="search"
      id="article-search"
      placeholder="搜尋文章關鍵字…"
      class="w-full rounded-full border border-chestnut/15 bg-white/60 py-3 pl-11 pr-5 text-sm text-chestnut placeholder:text-chestnut/40 focus:border-terracotta focus:outline-none"
    />
  </div>

  <div id="series-filter" class="flex flex-wrap gap-2" role="group" aria-label="依系列篩選">
    <button type="button" data-filter="all" class="filter-chip is-active">全部</button>
    {SERIES.map((series) => (
      <button type="button" data-filter={series.name} class="filter-chip">
        {series.name}
      </button>
    ))}
  </div>
</div>

<style>
  .filter-chip {
    @apply rounded-full border border-chestnut/15 bg-cream px-4 py-1.5 text-xs font-medium text-chestnut/70 transition-colors hover:border-terracotta hover:text-terracotta;
  }
  .filter-chip.is-active {
    @apply border-terracotta bg-terracotta text-cream hover:text-cream;
  }
</style>

<script>
  const searchInput = document.getElementById('article-search') as HTMLInputElement | null;
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-chip'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-article-card]'));
  const emptyState = document.getElementById('no-results');

  const params = new URLSearchParams(window.location.search);
  let activeFilter = params.get('series') ?? 'all';

  function applyFilters() {
    const query = (searchInput?.value ?? '').trim().toLowerCase();

    let visibleCount = 0;
    for (const card of cards) {
      const category = card.dataset.category ?? '';
      const searchText = card.dataset.search ?? '';
      const matchesFilter = activeFilter === 'all' || category === activeFilter;
      const matchesQuery = query === '' || searchText.includes(query);
      const visible = matchesFilter && matchesQuery;
      card.classList.toggle('hidden', !visible);
      if (visible) visibleCount += 1;
    }

    emptyState?.classList.toggle('hidden', visibleCount > 0);
  }

  function setActiveChip(filter: string) {
    activeFilter = filter;
    for (const chip of chips) {
      chip.classList.toggle('is-active', chip.dataset.filter === filter);
    }
  }

  setActiveChip(activeFilter);
  if (searchInput && params.get('q')) {
    searchInput.value = params.get('q') ?? '';
  }
  applyFilters();

  searchInput?.addEventListener('input', applyFilters);
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      setActiveChip(chip.dataset.filter ?? 'all');
      applyFilters();
    });
  });
</script>
