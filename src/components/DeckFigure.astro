---
/**
 * 簡報頁的示意圖。原始簡報是把圖烤進整頁點陣圖裡，這裡改用 inline SVG 重畫：
 * 線條吃系列強調色、放大不會糊、深淺背景都清楚，也不必為了一張裝飾圖多載一張圖片。
 * 圖形都刻意維持幾何、抽象——不畫具象人物，避免性議題的內容變得獵奇。
 */
interface Props {
  figure: {
    type: 'venn3' | 'ripple' | 'waves' | 'target' | 'strands';
    items: { letter: string; label: string }[];
  };
  class?: string;
}

const { figure, class: className = '' } = Astro.props;

/** venn3：上排兩圓相交，下方一個虛線圓與上排相交（BPS 那種三向交集） */
const VENN_CIRCLES = [
  { cx: 128, cy: 108, dashed: false },
  { cx: 212, cy: 108, dashed: false },
  { cx: 170, cy: 178, dashed: true },
];

/** ripple：同心圓漣漪（對應「被肯認」的水波意象） */
const RIPPLE_RADII = [14, 30, 46, 62, 78];

/** waves：層疊的浪（「被迴避」那組海浪線）；三條都以 x=100 為中心，逐層變窄 */
const WAVE_PATHS = [
  'M12,82 q22,-30 44,0 q22,30 44,0 q22,-30 44,0 q22,30 44,0',
  'M26,118 q18.5,-26 37,0 q18.5,26 37,0 q18.5,-26 37,0 q18.5,26 37,0',
  'M40,152 q15,-22 30,0 q15,22 30,0 q15,-22 30,0 q15,22 30,0',
];

/** strands：被兩道括號夾住、中段被擠窄的平行線（「被脅迫」的壓迫感） */
const STRAND_COUNT = 6;
---

<figure class:list={['deck-figure', className]}>
  {
    figure.type === 'venn3' && (
      <svg viewBox="0 0 340 280" role="img" aria-label={figure.items.map((item) => item.label).join('、')}>
        {VENN_CIRCLES.map((circle) => (
          <circle
            cx={circle.cx}
            cy={circle.cy}
            r="72"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-dasharray={circle.dashed ? '5 5' : undefined}
            opacity={circle.dashed ? 0.55 : 0.75}
          />
        ))}
        {figure.items[0] && (
          <>
            <text x="108" y="104" class="deck-figure-letter">{figure.items[0].letter}</text>
            <text x="108" y="122" class="deck-figure-caption">{figure.items[0].label}</text>
          </>
        )}
        {figure.items[1] && (
          <>
            <text x="232" y="104" class="deck-figure-letter">{figure.items[1].letter}</text>
            <text x="232" y="122" class="deck-figure-caption">{figure.items[1].label}</text>
          </>
        )}
        {figure.items[2] && (
          <>
            <text x="170" y="206" class="deck-figure-letter">{figure.items[2].letter}</text>
            <text x="170" y="224" class="deck-figure-caption">{figure.items[2].label}</text>
          </>
        )}
      </svg>
    )
  }

  {
    figure.type === 'ripple' && (
      <svg viewBox="0 0 200 200" role="presentation" aria-hidden="true">
        {RIPPLE_RADII.map((r, index) => (
          <circle
            cx="100"
            cy="100"
            r={r}
            fill="none"
            stroke="currentColor"
            stroke-width="3.5"
            opacity={0.9 - index * 0.13}
          />
        ))}
      </svg>
    )
  }

  {
    figure.type === 'waves' && (
      <svg viewBox="0 0 200 200" role="presentation" aria-hidden="true">
        {WAVE_PATHS.map((d, index) => (
          <path
            d={d}
            fill="none"
            stroke="currentColor"
            stroke-width="3.5"
            stroke-linecap="round"
            opacity={0.85 - index * 0.18}
          />
        ))}
      </svg>
    )
  }

  {
    figure.type === 'target' && (
      <svg viewBox="0 0 200 200" role="presentation" aria-hidden="true">
        <circle cx="100" cy="100" r="78" fill="none" stroke="currentColor" stroke-width="3.5" opacity="0.5" />
        <circle cx="100" cy="100" r="52" fill="none" stroke="currentColor" stroke-width="3.5" opacity="0.7" />
        <circle cx="100" cy="100" r="26" fill="none" stroke="currentColor" stroke-width="3.5" opacity="0.9" />
        <circle cx="100" cy="100" r="8" fill="currentColor" />
        <path
          d="M100,8 V44 M100,156 V192 M8,100 H44 M156,100 H192"
          stroke="currentColor"
          stroke-width="3.5"
          stroke-linecap="round"
          opacity="0.6"
        />
      </svg>
    )
  }

  {
    figure.type === 'strands' && (
      <svg viewBox="0 0 200 200" role="presentation" aria-hidden="true">
        {Array.from({ length: STRAND_COUNT }).map((_item, index) => {
          const y = 45 + index * 22;
          // 中段往中心線收攏，做出「被夾緊」的視覺
          const pinch = (y - 100) * 0.42;
          return (
            <path
              d={`M28,${y} C68,${y} 74,${y - pinch} 100,${y - pinch} C126,${y - pinch} 132,${y} 172,${y}`}
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              opacity="0.7"
            />
          );
        })}
        <path
          d="M72,28 H56 V172 H72 M128,28 H144 V172 H128"
          fill="none"
          stroke="var(--deck-ink)"
          stroke-width="6"
          stroke-linecap="square"
          opacity="0.7"
        />
      </svg>
    )
  }
</figure>

<style>
  .deck-figure {
    margin: 0;
    color: var(--deck-accent);
  }

  .deck-figure svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .deck-figure-letter {
    fill: var(--deck-ink);
    font-size: 20px;
    font-weight: 600;
    text-anchor: middle;
    opacity: 0.85;
  }

  .deck-figure-caption {
    fill: var(--deck-ink);
    font-size: 10px;
    letter-spacing: 0.04em;
    text-anchor: middle;
    opacity: 0.55;
  }
</style>
