---
import type { CollectionEntry } from 'astro:content';
import CoverArt from './CoverArt.astro';
import SofaCounter from './SofaCounter.astro';
import { getSeriesByName } from '../lib/series';
import { wrapTitleHtml } from '../lib/wrap-title';

interface Props {
  entry: CollectionEntry<'articles'>;
  /** 卡片標題的標題階層，依所在頁面的標題結構調整（首頁 h3／文章列表頁 h2） */
  headingLevel?: 'h2' | 'h3';
}

const { entry, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;

const series = getSeriesByName(entry.data.category);
const formattedDate = entry.data.date.toLocaleDateString('zh-TW', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const searchText = [entry.data.title, entry.data.summary, entry.data.category, ...entry.data.tags]
  .join(' ')
  .toLowerCase();
---

<a
  href={`/articles/${entry.slug}`}
  data-article-card
  data-category={entry.data.category}
  data-search={searchText}
  class="group flex flex-col overflow-hidden rounded-2xl border border-[var(--color-border)] bg-white transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_16px_40px_-16px_rgba(61,64,67,0.25)]"
>
  <div class="aspect-video w-full overflow-hidden">
    {
      entry.data.cover ? (
        <img
          src={entry.data.cover}
          alt={entry.data.title}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
        />
      ) : (
        <CoverArt
          category={entry.data.category}
          seed={entry.slug}
          class="h-full w-full transition-transform duration-300 group-hover:scale-[1.03]"
        />
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-6">
    <span class={`inline-flex w-fit items-center rounded-full px-3 py-1 text-xs font-medium ${series.badge}`}>
      {entry.data.category}
    </span>

    <Heading
      class="mt-3 font-serif text-xl font-semibold leading-snug text-chestnut transition-colors group-hover:text-[var(--color-primary)]"
      set:html={wrapTitleHtml(entry.data.title)}
    />

    <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-[var(--color-text-muted)]">
      {entry.data.summary}
    </p>

    <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-[var(--color-text-muted)]">
      <time datetime={entry.data.date.toISOString()} class="inline-flex items-center gap-1">
        <span aria-hidden="true">📅</span>
        {formattedDate}
      </time>
      <span class="inline-flex items-center gap-1">
        <span aria-hidden="true">🏷️</span>
        {entry.data.category}
      </span>
    </div>

    <div class="mt-3">
      <SofaCounter type="post" slug={entry.slug} readOnly />
    </div>
  </div>
</a>
