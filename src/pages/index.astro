---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import CoverArt from '../components/CoverArt.astro';
import { getCollection } from 'astro:content';
import { SERIES, getSeriesByName } from '../lib/series';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const latestArticles = articles.slice(0, 6);
---

<BaseLayout title="首頁">
  <section class="mx-auto max-w-5xl px-6 pb-16 pt-20 sm:pt-28">
    <Logo class="h-16 w-auto sm:h-20" />

    <h1 class="mt-8 whitespace-nowrap font-serif text-[clamp(1.1rem,5vw,3.25rem)] font-semibold leading-tight text-chestnut">
      把學術搬進客廳，把親密聊成日常。
    </h1>
    <p class="mt-4 max-w-xl font-serif text-xl italic text-terracotta">
      躺進沙發，感受心理與性。
    </p>
    <p class="mt-6 max-w-xl text-lg leading-relaxed text-chestnut/70">
      沙發上的性心理，用心理學的視角陪你梳理親密關係、身體與情慾裡那些說不出口的困惑，
      找到一個安心攤在沙發上、慢慢聊的空間。
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="/articles"
        class="rounded-full bg-chestnut px-6 py-3 text-sm font-medium text-cream transition-colors hover:bg-terracotta"
      >
        閱讀文章
      </a>
      <a
        href="/about"
        class="rounded-full border border-chestnut/20 px-6 py-3 text-sm font-medium text-chestnut transition-colors hover:border-terracotta hover:text-terracotta"
      >
        認識創辦人
      </a>
    </div>
  </section>

  <section class="border-y border-chestnut/10 bg-terracotta/5">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-sm font-medium uppercase tracking-[0.2em] text-chestnut/50">五大主題系列</p>
      <h2 class="mt-2 font-serif text-2xl font-semibold text-chestnut sm:text-3xl">我們聊的，都在這五個沙發角落</h2>

      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          SERIES.map((series, index) => (
            <a
              href={`/articles?series=${encodeURIComponent(series.name)}`}
              class={`group flex flex-col rounded-2xl border-2 bg-cream p-6 transition-transform hover:-translate-y-1 ${series.border}`}
            >
              <span class={`inline-flex w-fit items-center gap-1.5 rounded-full px-3 py-1 text-xs font-medium ${series.badge}`}>
                系列 {String(index + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-4 font-serif text-lg font-semibold text-chestnut group-hover:text-terracotta">
                {series.name}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-chestnut/70">{series.tagline}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section id="articles" class="mx-auto max-w-5xl px-6 py-20">
    <div class="flex items-end justify-between gap-4">
      <h2 class="font-serif text-2xl font-semibold text-chestnut sm:text-3xl">最新文章</h2>
      <a href="/articles" class="text-sm font-medium text-terracotta hover:underline">
        查看全部 →
      </a>
    </div>

    {
      latestArticles.length === 0 ? (
        <p class="mt-8 text-chestnut/60">文章準備中，敬請期待。</p>
      ) : (
        <div class="mt-10 grid gap-8 sm:grid-cols-2">
          {latestArticles.map((article) => {
            const series = getSeriesByName(article.data.category);
            return (
              <a
                href={`/articles/${article.slug}`}
                class="group flex flex-col overflow-hidden rounded-2xl border border-chestnut/10 bg-white/40 transition-colors hover:border-terracotta/40"
              >
                <div class="aspect-video w-full overflow-hidden">
                  {article.data.cover ? (
                    <img
                      src={article.data.cover}
                      alt={article.data.title}
                      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                    />
                  ) : (
                    <CoverArt
                      category={article.data.category}
                      seed={article.slug}
                      class="h-full w-full transition-transform duration-300 group-hover:scale-105"
                    />
                  )}
                </div>
                <div class="flex flex-1 flex-col p-6">
                  <span class={`inline-flex w-fit items-center rounded-full px-3 py-1 text-xs font-medium ${series.badge}`}>
                    {article.data.category}
                  </span>
                  <h3 class="mt-3 font-serif text-xl font-semibold leading-snug text-chestnut group-hover:text-terracotta">
                    {article.data.title}
                  </h3>
                  <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-chestnut/70">
                    {article.data.summary}
                  </p>
                  <time class="mt-4 text-xs text-chestnut/50" datetime={article.data.date.toISOString()}>
                    {article.data.date.toLocaleDateString('zh-TW', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                    })}
                  </time>
                </div>
              </a>
            );
          })}
        </div>
      )
    }
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-24">
    <div class="rounded-3xl bg-chestnut px-8 py-14 text-center text-cream sm:px-16">
      <h2 class="font-serif text-2xl font-semibold sm:text-3xl">想聊聊你的故事嗎？</h2>
      <p class="mx-auto mt-3 max-w-md text-cream/80">
        歡迎與我們聯繫，一起把難以啟齒的話題，慢慢說開。
      </p>
      <a
        href="#contact"
        class="mt-6 inline-block rounded-full bg-terracotta px-6 py-3 text-sm font-medium text-cream transition-colors hover:bg-caramel"
      >
        前往聯絡我們
      </a>
    </div>
  </section>
</BaseLayout>
