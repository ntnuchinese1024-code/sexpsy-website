---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { SERIES } from '../lib/series';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const latestArticles = articles.slice(0, 6);
---

<BaseLayout title="首頁">
  <Hero />

  <section class="border-y border-chestnut/10 bg-terracotta/5">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-sm font-medium uppercase tracking-[0.2em] text-chestnut/50">六大主題系列</p>
      <h2 class="mt-2 font-serif text-2xl font-semibold text-chestnut sm:text-3xl">我們聊的，都在這六個沙發角落</h2>

      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          SERIES.map((series, index) => (
            <a
              href={`/articles?series=${encodeURIComponent(series.name)}`}
              class={`group flex flex-col rounded-2xl border-2 bg-cream p-6 transition-transform hover:-translate-y-1 ${series.border}`}
            >
              <span class={`inline-flex w-fit items-center gap-1.5 rounded-full px-3 py-1 text-xs font-medium ${series.badge}`}>
                系列 {String(index + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-4 font-serif text-lg font-semibold text-chestnut group-hover:text-terracotta">
                {series.title ?? series.name}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-chestnut/70">{series.tagline}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section id="articles" class="mx-auto max-w-5xl px-6 py-20">
    <div class="flex items-end justify-between gap-4">
      <h2 class="font-serif text-2xl font-semibold text-chestnut sm:text-3xl">最新文章</h2>
      <a href="/articles" class="text-sm font-medium text-terracotta hover:underline">
        查看全部 →
      </a>
    </div>

    {
      latestArticles.length === 0 ? (
        <p class="mt-8 text-chestnut/60">文章準備中，敬請期待。</p>
      ) : (
        <div class="mt-10 grid gap-8 sm:grid-cols-2">
          {latestArticles.map((article) => (
            <ArticleCard entry={article} headingLevel="h3" />
          ))}
        </div>
      )
    }
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-24">
    <div class="rounded-3xl bg-chestnut px-8 py-14 text-center text-cream sm:px-16">
      <h2 class="font-serif text-2xl font-semibold sm:text-3xl">想聊聊你的故事嗎？</h2>
      <p class="mx-auto mt-3 max-w-md text-cream/80">
        歡迎與我們聯繫，一起把難以啟齒的話題，慢慢說開。
      </p>
      <a
        href="/contact"
        class="mt-6 inline-block rounded-full bg-terracotta px-6 py-3 text-sm font-medium text-cream transition-colors hover:bg-caramel"
      >
        前往聯絡我們
      </a>
    </div>
  </section>
</BaseLayout>
