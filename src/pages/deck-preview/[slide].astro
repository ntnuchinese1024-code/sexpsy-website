---
/**
 * 暫時性的簡報版面預覽頁（只存在 feature/article-slide-deck 分支，合併前要刪掉）。
 * 用途：讓 headless Chrome 一頁一頁把簡報截圖出來檢查版面，不用手動翻頁。
 * 靜態輸出模式下 Astro.url.searchParams 拿不到值，所以做成動態路由 /deck-preview/3。
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SlideDeck from '../../components/SlideDeck.astro';

export async function getStaticPaths() {
  const decks = await getCollection('decks');
  return decks.flatMap((deck) =>
    deck.data.slides.map((_slide, index) => ({
      params: { slide: `${deck.id}-${index + 1}` },
      props: { deckId: deck.id, index: index + 1 },
    }))
  );
}

const { deckId, index } = Astro.props;
---

<BaseLayout title="簡報版面預覽" description="開發用預覽頁">
  <div class="mx-auto max-w-[900px] px-6 py-10">
    <SlideDeck deck={deckId} category="馬鈴薯嗑論文" />
  </div>
  <Fragment
    set:html={`<style>.deck-slide{display:none !important}.deck-slide:nth-of-type(${index}){display:block !important}</style>`}
  />
</BaseLayout>
