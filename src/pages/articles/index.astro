---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SearchBar from '../../components/SearchBar.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="所有文章" description="沙發上的性心理所有文章：六大系列 Tag 篩選與關鍵字搜尋。">
  <section class="mx-auto max-w-5xl px-6 pb-24 pt-20 sm:pt-28">
    <p class="text-sm font-medium uppercase tracking-[0.2em] text-terracotta">Articles</p>
    <h1 class="mt-2 font-serif text-3xl font-semibold text-chestnut sm:text-4xl">所有文章</h1>
    <p class="mt-3 max-w-xl text-chestnut/70">
      窩在沙發上慢慢逛，用系列篩選或關鍵字，找到現在最想聊的話題。
    </p>

    <div class="mt-10">
      <SearchBar />
    </div>

    {
      articles.length === 0 ? (
        <p class="text-chestnut/60">文章準備中，敬請期待。</p>
      ) : (
        <div class="grid gap-8 sm:grid-cols-2">
          {articles.map((article) => (
            <ArticleCard entry={article} headingLevel="h2" />
          ))}
        </div>
      )
    }

    <p id="no-results" class="hidden py-16 text-center text-chestnut/50">
      沒有符合條件的文章，換個關鍵字或系列試試看吧。
    </p>
  </section>
</BaseLayout>
