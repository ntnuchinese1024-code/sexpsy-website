---
import { getCollection } from 'astro:content';
import SelfStudyDashboardLayout from '../../../layouts/SelfStudyDashboardLayout.astro';
import { STUDY_ROOMS, getRoomBySlug } from '../../../lib/self-study-rooms';

export async function getStaticPaths() {
  return STUDY_ROOMS.map((room) => ({ params: { room: room.slug } }));
}

const { room: roomSlug } = Astro.params;
const room = getRoomBySlug(roomSlug!)!;

const roomUnits = await getCollection('self-study', (entry) => entry.data.room === room.slug);
const units = roomUnits
  .sort((a, b) => a.data.order - b.data.order)
  .map((unit) => ({ slug: unit.slug, title: unit.data.title, tags: unit.data.tags }));
---

<SelfStudyDashboardLayout room={room} units={units} title={room.name} description={room.tagline}>
  <div class="rounded-2xl border border-chestnut/10 bg-white/40 p-8">
    <h1 class="font-serif text-2xl font-semibold text-chestnut">{room.icon} {room.name}</h1>
    <p class="mt-3 max-w-xl text-base leading-relaxed text-chestnut/70">{room.tagline}</p>
  </div>

  {
    units.length === 0 ? (
      <p class="mt-8 text-sm text-chestnut/50">這個房間的單元還在準備中，敬請期待。</p>
    ) : (
      <div class="mt-8 grid gap-5 sm:grid-cols-2">
        {units.map((unit) => (
          <a
            href={`/self-study/${room.slug}/${unit.slug}`}
            class="rounded-2xl border border-chestnut/10 bg-white/50 p-6 transition-colors hover:border-terracotta/50"
          >
            <h2 class="font-serif text-base font-semibold text-chestnut">{unit.title}</h2>
            {unit.tags.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-2">
                {unit.tags.map((tag) => (
                  <span class="rounded-full bg-terracotta/10 px-2.5 py-0.5 text-xs text-terracotta">#{tag}</span>
                ))}
              </div>
            )}
          </a>
        ))}
      </div>
    )
  }
</SelfStudyDashboardLayout>
