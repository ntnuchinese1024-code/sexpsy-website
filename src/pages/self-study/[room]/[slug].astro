---
import { getCollection, getEntries } from 'astro:content';
import SelfStudyDashboardLayout from '../../../layouts/SelfStudyDashboardLayout.astro';
import SelfStudyUnitPanel from '../../../components/SelfStudyUnitPanel.astro';
import { getRoomBySlug } from '../../../lib/self-study-rooms';

export async function getStaticPaths() {
  const allUnits = await getCollection('self-study');
  return allUnits.map((unit) => ({
    params: { room: unit.data.room, slug: unit.slug },
    props: { unit },
  }));
}

const { unit } = Astro.props;
const room = getRoomBySlug(unit.data.room)!;
const { Content } = await unit.render();

/** 從陣列中隨機挑 count 篇，不重複 */
function pickRandom<T>(pool: T[], count: number): T[] {
  const copy = [...pool];
  const picked: T[] = [];
  while (picked.length < count && copy.length > 0) {
    const i = Math.floor(Math.random() * copy.length);
    picked.push(copy.splice(i, 1)[0]);
  }
  return picked;
}

const RANDOM_RELATED_COUNT = 3;

let relatedArticles: { slug: string; title: string }[];
let relatedArticlesIsRandom = false;

if (unit.data.relatedArticles.length > 0) {
  relatedArticles = (await getEntries(unit.data.relatedArticles)).map((article) => ({
    slug: article.slug,
    title: article.data.title,
  }));
} else {
  // 沒有指定延伸閱讀時，隨機推薦幾篇文章，避免這個區塊整個消失
  const allArticles = await getCollection('articles');
  relatedArticles = pickRandom(allArticles, RANDOM_RELATED_COUNT).map((article) => ({
    slug: article.slug,
    title: article.data.title,
  }));
  relatedArticlesIsRandom = true;
}

const roomUnits = await getCollection('self-study', (entry) => entry.data.room === room.slug);
const units = roomUnits
  .sort((a, b) => a.data.order - b.data.order)
  .map((u) => ({ slug: u.slug, title: u.data.title, tags: u.data.tags }));
---

<SelfStudyDashboardLayout
  room={room}
  units={units}
  activeSlug={unit.slug}
  title={unit.data.title}
  description={unit.data.summary}
>
  <SelfStudyUnitPanel
    title={unit.data.title}
    summary={unit.data.summary}
    room={room}
    downloadPdf={unit.data.downloadPdf}
    downloadWord={unit.data.downloadWord}
    aiPrompt={unit.data.aiPrompt}
    tags={unit.data.tags}
    estimatedMinutes={unit.data.estimatedMinutes}
    difficulty={unit.data.difficulty}
    relatedArticles={relatedArticles}
  >
    <Content />
  </SelfStudyUnitPanel>
</SelfStudyDashboardLayout>
