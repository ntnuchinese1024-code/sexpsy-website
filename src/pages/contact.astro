---
import BaseLayout from '../layouts/BaseLayout.astro';

const categories = [
  { value: '枕邊悄悄話', label: '☁️ 枕邊悄悄話' },
  { value: '沙發上的私房故事', label: '📖 沙發上的私房故事' },
  { value: '客廳的許願樹', label: '🎈 客廳的許願樹' },
  { value: '其他', label: '其他' },
];

const infoCards = [
  {
    icon: '☁️',
    title: '枕邊悄悄話',
    description: '對於文章有任何感想、提問或共鳴，歡迎隨時跟我說。',
  },
  {
    icon: '📖',
    title: '沙發上的私房故事',
    description:
      '想分享自己的故事嗎？每一封信都會經過溫柔審查，確認適合後才會以完全匿名並去化個人資訊的方式刊登。',
  },
  {
    icon: '🎈',
    title: '客廳的許願樹',
    description: '有沒有哪些關於性、性別、心理或情感關係的議題，是你希望這張沙發能聊聊的？',
  },
];

const inputClass =
  'w-full rounded-xl border border-chestnut/15 bg-white/70 px-4 py-3 text-sm text-[var(--color-text-primary)] transition-colors placeholder:text-[var(--color-text-muted)] focus:border-[var(--color-primary)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]/15';
---

<BaseLayout
  title="沙發邊的信箱"
  description="不管是讀完文章後的悄悄話、你想寄放的故事，或是想聽的主題，都歡迎在這裡投遞。"
>
  <section class="mx-auto max-w-3xl px-6 pb-10 pt-20 text-center sm:pt-28">
    <p class="text-sm font-medium uppercase tracking-[0.25em] text-[var(--color-primary)]">Contact</p>
    <h1 class="mt-3 font-serif text-3xl font-semibold text-chestnut sm:text-4xl">沙發邊的信箱</h1>
    <p class="mx-auto mt-4 max-w-xl text-lg leading-relaxed text-[var(--color-text-muted)]">
      不管是讀完文章後的悄悄話、你想寄放的故事，或是想聽的主題，都歡迎在這裡投遞。
    </p>
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-6">
    <div class="flex gap-4 rounded-2xl bg-[#e2d2c9] p-6 sm:p-7">
      <span class="text-2xl" aria-hidden="true">🛋️</span>
      <div class="space-y-3 text-sm leading-relaxed text-[var(--color-text-primary)]">
        <p>
          本網站為知識分享與故事記錄空間，<strong class="font-semibold">不提供線上心理諮商、心理諮詢或緊急危機處置服務</strong>。若有緊急心理需求，請洽專業醫療機構或生命線（<a
            href="tel:1995"
            class="font-semibold underline underline-offset-2">1995</a
          >）。
        </p>
        <p>
          回信需要時間，如果沒有及時收到回覆，別擔心，我可能正窩在沙發上看書、泡茶或發呆呢！謝謝你的體諒，讓我能用最舒心的節奏閱讀每一封來信。
        </p>
        <p>
          官方信箱：
          <a href="mailto:sexpsy.tw@gmail.com" class="font-semibold underline underline-offset-2"
            >sexpsy.tw@gmail.com</a
          >
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-10">
    <div class="grid gap-5 sm:grid-cols-3">
      {
        infoCards.map((card) => (
          <div class="rounded-2xl border border-chestnut/10 bg-white/50 p-6 text-center">
            <span class="text-2xl" aria-hidden="true">
              {card.icon}
            </span>
            <h2 class="mt-3 font-serif text-base font-semibold text-chestnut">{card.title}</h2>
            <p class="mt-2 text-sm leading-relaxed text-[var(--color-text-muted)]">{card.description}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-2xl px-6 pb-24">
    <div class="rounded-3xl border border-chestnut/10 bg-white/60 p-6 sm:p-10">
      <form id="contact-form" class="space-y-5" novalidate>
        <!--
          Web3Forms 設定：
          Access Key 設計上就是給前端明文使用的（Web3Forms 官方文件的標準用法），
          垃圾訊息防護、網域限制等是在 Web3Forms 後台設定，不需要像密鑰一樣藏起來。
        -->
        <input type="hidden" name="access_key" value="77c78a23-4a8c-4442-a247-6f6dcb8faf05" />
        <input type="hidden" name="subject" value="沙發上的性心理｜有新的信投進來了" />
        <!-- 防機器人蜜罐欄位，人類看不到、不會填，機器人常會誤填 -->
        <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off" />

        <div>
          <label for="category" class="mb-1.5 block text-sm font-medium text-chestnut">投遞類別</label>
          <select id="category" name="category" required class={inputClass}>
            {categories.map((option) => <option value={option.value}>{option.label}</option>)}
          </select>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="name" class="mb-1.5 block text-sm font-medium text-chestnut">你的暱稱／稱呼</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="想被怎麼稱呼都可以"
              class={inputClass}
            />
          </div>
          <div>
            <label for="email" class="mb-1.5 block text-sm font-medium text-chestnut">聯絡 Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="方便回信給你"
              class={inputClass}
            />
          </div>
        </div>

        <div>
          <label for="message" class="mb-1.5 block text-sm font-medium text-chestnut">訊息內容</label>
          <textarea
            id="message"
            name="message"
            required
            rows="6"
            placeholder="想說什麼都可以，慢慢寫"
            class={`${inputClass} resize-y`}
          ></textarea>
        </div>

        <button
          type="submit"
          id="contact-submit"
          class="w-full rounded-full bg-[var(--color-primary)] px-6 py-3 text-sm font-medium text-cream transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-60"
        >
          寄出這封信
        </button>

        <p
          id="contact-status"
          class="hidden rounded-xl px-4 py-3 text-sm leading-relaxed"
          role="status"
          aria-live="polite"
        >
        </p>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitButton = document.getElementById('contact-submit') as HTMLButtonElement | null;
  const statusEl = document.getElementById('contact-status');

  function setStatus(message: string, tone: 'success' | 'error') {
    if (!statusEl) return;
    statusEl.textContent = message;
    statusEl.classList.remove('hidden');
    statusEl.classList.toggle('bg-[var(--color-accent)]/20', tone === 'success');
    statusEl.classList.toggle('text-[var(--color-text-primary)]', tone === 'success');
    statusEl.classList.toggle('bg-red-50', tone === 'error');
    statusEl.classList.toggle('text-red-700', tone === 'error');
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !submitButton) return;

    submitButton.disabled = true;
    submitButton.textContent = '寄送中…';
    statusEl?.classList.add('hidden');

    try {
      const formData = new FormData(form);
      const payload = Object.fromEntries(formData.entries());

      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
        },
        body: JSON.stringify(payload),
      });

      const result = await response.json();

      if (result.success) {
        setStatus('信件已順利寄出，謝謝你寄放的心意 🛋️', 'success');
        form.reset();
      } else {
        setStatus(
          '寄送時遇到一點小狀況，要不要直接寫信到 sexpsy.tw@gmail.com？',
          'error'
        );
      }
    } catch (error) {
      setStatus('網路好像不太順，要不要直接寫信到 sexpsy.tw@gmail.com？', 'error');
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = '寄出這封信';
    }
  });
</script>
